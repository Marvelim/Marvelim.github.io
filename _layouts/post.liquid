---
layout: default
---
{% assign year = page.date | date: '%Y' %}
{% assign tags = page.tags | join: '' %}
{% assign categories = page.categories | join: '' %}
{% assign url_beginning = page.url | slice: 0, 6 %}
{% assign post_password = page.password | default: site.blog_default_password %}
{% assign post_is_locked = false %}
{% if post_password and post_password != '' %}
  {% assign post_is_locked = true %}
{% endif %}

{% if page._styles %}
  <!-- Page/Post style -->
  <style type="text/css">
    {{ page._styles }}
  </style>
{% endif %}

{% if post_is_locked %}
  <style type="text/css">
    .post-password-gate {
      margin: 1rem 0 1.5rem;
      padding: 1.25rem;
      border: 1px solid var(--global-divider-color);
      border-radius: 10px;
      background: var(--global-card-bg-color);
    }

    .post-password-gate h3 {
      margin: 0 0 0.5rem;
      font-size: 1.1rem;
    }

    .post-password-controls {
      display: flex;
      flex-wrap: wrap;
      gap: 0.5rem;
      margin-top: 0.75rem;
    }

    #post-password-input {
      min-width: 220px;
      max-width: 320px;
      padding: 0.45rem 0.6rem;
      border: 1px solid var(--global-divider-color);
      border-radius: 6px;
      background: var(--global-bg-color);
      color: var(--global-text-color);
    }

    #post-password-input.wrong {
      border-color: #d33;
    }

    #post-password-submit {
      padding: 0.45rem 0.9rem;
      border: 1px solid var(--global-theme-color);
      border-radius: 6px;
      background: var(--global-theme-color);
      color: var(--global-hover-text-color);
      cursor: pointer;
    }

    #post-password-error {
      margin: 0.5rem 0 0;
      color: #d33;
    }
  </style>
{% endif %}

<div class="post">
  <header class="post-header">
    <h1 class="post-title">{{ page.title }}</h1>
    <p class="post-meta">
      Created on {{ page.date | date: '%B %d, %Y' }}
      {% if page.author %}by {{ page.author }}{% endif %}
      {% if page.last_updated %}, last updated on {{ page.last_updated | date: '%B %d, %Y' }}{% endif %}
      {% if page.meta %}• {{ page.meta }}{% endif %}
    </p>
    <p class="post-tags">
      {% if url_beginning == '/blog/' %}
        <a href="{{ year | prepend: '/blog/' | relative_url }}"> <i class="fa-solid fa-calendar fa-sm"></i> {{ year }} </a>
      {% else %}
        <i class="fa-solid fa-calendar fa-sm"></i> {{ year }}
      {% endif %}
      {% if tags != '' %}
        &nbsp; &middot; &nbsp;
        {% for tag in page.tags %}
          {% if url_beginning == '/blog/' %}
            <a href="{{ tag | slugify | prepend: '/blog/tag/' | relative_url }}"> <i class="fa-solid fa-hashtag fa-sm"></i> {{ tag }}</a>
          {% else %}
            <i class="fa-solid fa-hashtag fa-sm"></i> {{ tag }}
          {% endif %}
          {% unless forloop.last %}
            &nbsp;
          {% endunless %}
        {% endfor %}
      {% endif %}

      {% if categories != '' %}
        &nbsp; &middot; &nbsp;
        {% for category in page.categories %}
          {% if url_beginning == '/blog/' %}
            <a href="{{ category | slugify | prepend: '/blog/category/' | relative_url }}"> <i class="fa-solid fa-tag fa-sm"></i> {{ category -}}</a>
          {% else %}
            <i class="fa-solid fa-tag fa-sm"></i> {{ category }}
          {% endif %}
          {% unless forloop.last %}
            &nbsp;
          {% endunless %}
        {% endfor %}
      {% endif %}
    </p>
  </header>

  {% if post_is_locked %}
    <div id="post-password-gate" class="post-password-gate">
      <h3>本文已加口令保护</h3>
      <p>请输入口令后查看正文。</p>
      <div class="post-password-controls">
        <input id="post-password-input" type="password" placeholder="输入口令" autocomplete="current-password">
        <button id="post-password-submit" type="button">解锁</button>
      </div>
      <p id="post-password-error" hidden>口令不正确，请重试。</p>
    </div>
    <noscript>
      <p>该文章需要启用 JavaScript 后才能输入口令。</p>
    </noscript>
  {% endif %}

  <div id="post-protected-content" {% if post_is_locked %}hidden{% endif %}>
    <article class="post-content">
      {% if page.toc and page.toc.beginning %}
        <div id="table-of-contents">
          {% toc %}
        </div>
        <hr>
      {% endif %}
      <div id="markdown-content">
        {{ content }}
      </div>
    </article>

    {% if page.citation %}
      {% include citation.liquid %}
    {% endif %}

    {% if page.related_publications %}
      <h2>References</h2>
      <div class="publications">
        {% bibliography --group_by none --cited_in_order %}
      </div>
    {% endif %}

    {% if site.related_blog_posts and site.related_blog_posts.enabled %}
      {% if page.related_posts == null or page.related_posts %}
        {% include related_posts.liquid %}
      {% endif %}
    {% endif %}

    {% if site.disqus_shortname and page.disqus_comments %}
      {% include disqus.liquid %}
    {% endif %}
    {% if site.giscus and page.giscus_comments %}
      {% include giscus.liquid %}
    {% endif %}
  </div>

  {% if post_is_locked %}
    <script>
      (function () {
        const expectedPassword = {{ post_password | jsonify }};
        const postPath = {{ page.url | jsonify }};
        const gate = document.getElementById("post-password-gate");
        const protectedContent = document.getElementById("post-protected-content");
        const passwordInput = document.getElementById("post-password-input");
        const submitButton = document.getElementById("post-password-submit");
        const errorMessage = document.getElementById("post-password-error");

        if (!expectedPassword || !gate || !protectedContent || !passwordInput || !submitButton || !errorMessage) {
          return;
        }

        const storageKey = "alfolio-post-unlocked:" + postPath;
        let storage = null;

        try {
          storage = window.localStorage;
        } catch (error) {
          storage = null;
        }

        const unlock = function () {
          gate.hidden = true;
          protectedContent.hidden = false;
        };

        if (storage && storage.getItem(storageKey) === "1") {
          unlock();
          return;
        }

        const tryUnlock = function () {
          if (passwordInput.value === expectedPassword) {
            if (storage) {
              storage.setItem(storageKey, "1");
            }
            unlock();
            return;
          }

          errorMessage.hidden = false;
          passwordInput.classList.add("wrong");
          passwordInput.focus();
          passwordInput.select();
        };

        submitButton.addEventListener("click", tryUnlock);

        passwordInput.addEventListener("keydown", function (event) {
          if (event.key === "Enter") {
            event.preventDefault();
            tryUnlock();
          }
        });

        passwordInput.addEventListener("input", function () {
          errorMessage.hidden = true;
          passwordInput.classList.remove("wrong");
        });
      })();
    </script>
  {% endif %}
</div>
